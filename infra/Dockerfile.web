# Web image: Bun builds the SPA and the server into one bundle (design D1). Context: repo root.
FROM oven/bun:1.3.13 AS build
WORKDIR /app
COPY package.json bun.lock .bun-version ./
COPY apps/web/package.json apps/web/package.json
RUN bun install --frozen-lockfile
COPY apps/web/ apps/web/
RUN cd apps/web && bun run build

FROM oven/bun:1.3.13-slim
# Bun 1.3 resolves the bundled HTML assets relative to the working directory, so run from dist/.
WORKDIR /app/dist
COPY --from=build /app/apps/web/dist ./
ENV NODE_ENV=production \
    PORT=3000
EXPOSE 3000
USER bun
CMD ["bun", "server.js"]
