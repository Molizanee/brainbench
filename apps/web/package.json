{
  "name": "@brainbench/web",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.13"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build --target=bun --minify --sourcemap=linked server.ts --outdir dist",
    "start": "cd dist && bun server.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests server.ts && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.3.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
